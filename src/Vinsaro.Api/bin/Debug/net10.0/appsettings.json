{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "PLACEHOLDER — set via environment variable or user secrets. See docs/supabase-setup.md"
  },
  "Jwt": {
    "Key": "PLACEHOLDER — minimum 32 chars, set via environment variable or user secrets",
    "Issuer": "vinsaro-api",
    "Audience": "vinsaro-client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Store": {
    "Currency": "BDT",
    "DefaultDeliveryChargeBDT": 60,
    "FreeDeliveryThresholdBDT": 1000
  },
  "AllowedHosts": "*"
}
